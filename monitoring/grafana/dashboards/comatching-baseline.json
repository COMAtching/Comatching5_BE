{
  "uid": "comatching-baseline",
  "title": "Comatching Baseline",
  "tags": ["comatching", "phase0"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up{job=\"comatching-services\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Kafka consumer lag (max)",
      "description": "kafka_consumer_fetch_manager_records_lag_max — 컨슈머가 밀리는 정도. Phase 1 개선의 핵심 비교 지표.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service, client_id) (kafka_consumer_fetch_manager_records_lag_max{service=~\"$service\"})",
          "legendFormat": "{{service}} / {{client_id}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kafka listener p95 (s)",
      "description": "spring_kafka_listener_seconds — 리스너가 메시지 1건을 처리하는 시간. 최소 1건 처리 후부터 나타난다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service, name) (rate(spring_kafka_listener_seconds_bucket{service=~\"$service\"}[1m])))",
          "legendFormat": "{{service}} / {{name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP p95 by service (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_seconds_bucket{service=~\"$service\"}[1m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP throughput & 5xx (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}} total"
        },
        {
          "refId": "B",
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\", status=~\"5..\"}[1m]))",
          "legendFormat": "{{service}} 5xx"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HikariCP pending connections",
      "description": "hikaricp_connections_pending — 0보다 크면 풀(maximum-pool-size: 10)이 병목. user/matching/item 만 해당.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending{service=~\"$service\"}",
          "legendFormat": "{{service}} / {{pool}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HikariCP active / max",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{service=~\"$service\"}",
          "legendFormat": "{{service}} active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_max{service=~\"$service\"}",
          "legendFormat": "{{service}} max"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JVM GC pause (avg, s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(jvm_gc_pause_seconds_sum{service=~\"$service\"}[1m]) / clamp_min(rate(jvm_gc_pause_seconds_count{service=~\"$service\"}[1m]), 1)",
          "legendFormat": "{{service}} / {{action}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM heap used / max",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (jvm_memory_used_bytes{service=~\"$service\", area=\"heap\"})",
          "legendFormat": "{{service}} used"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Targets UP",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 32 },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"comatching-services\"}",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ]
    }
  ]
}