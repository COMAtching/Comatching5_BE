          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT CASE\n    WHEN DIGEST_TEXT LIKE '%candidate_hobby_categories%' THEN '3. 취미 컬렉션 (N+1)'\n    WHEN DIGEST_TEXT LIKE '%matching_history%'           THEN '1. 제외 목록'\n    WHEN DIGEST_TEXT LIKE '%matching_candidate%'         THEN '2. 후보 페이지'\n    ELSE LEFT(DIGEST_TEXT, 40)\n  END AS kind, ROUND(SUM(SUM_TIMER_WAIT)/1e9, 1) AS ms\nFROM performance_schema.events_statements_summary_by_digest\n WHERE SCHEMA_NAME = 'comatching_matching'\n   AND DIGEST_TEXT LIKE 'SELECT%'\n   AND DIGEST_TEXT NOT LIKE '%performance_schema%'\n   AND DIGEST_TEXT NOT LIKE '%ROW_NUMBER%'\n   AND DIGEST_TEXT NOT LIKE 'SELECT @@%'\n GROUP BY kind ORDER BY ms DESC;"
        }
