# cp .env.local.example .env.local
# JWT_SECRET: openssl rand -base64 64 | tr -d '\n'
# INTERNAL_SERVICE_TOKEN: openssl rand -hex 32
# 이 두 키는 로컬 전용으로 생성한다. 실제 .env.local은 Git에서 제외된다.
SPRING_PROFILES_ACTIVE=local

# 인증
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
ACCESS_TOKEN_EXP=86400000
REFRESH_TOKEN_EXP=604800000

# 노트북에 설치된 MySQL. 기존 로컬 계정 설정에 맞춘다.
LOCAL_MYSQL_HOST=127.0.0.1
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_USERNAME=root
LOCAL_MYSQL_PASSWORD=

# 외부 연동만 운영 설정에서 필요한 값을 복사한다.
# 아래 더미값으로 기동할 수 있지만 이메일/카카오/S3 기능은 동작하지 않는다.
SMTP_PASSWORD=local-disabled
AWS_ACCESS_KEY=local-disabled
AWS_SECRET_KEY=local-disabled
AWS_S3_BUCKET=comatching-local
KAKAO_CLIENT_ID=local-disabled
KAKAO_CLIENT_SECRET=local-disabled
KAKAO_ADMIN_KEY=local-disabled

# Firebase 키가 없어도 로컬은 기동 가능. 실제 푸시 확인 시 키를 넣고 true로 변경.
FCM_REQUIRED=false
FCM_SERVICE_ACCOUNT_B64=

# 로컬 전용 설정. 운영의 CLIENT_URL/쿠키/RDS/Redis 설정을 복사하지 않는다.
CLIENT_URL=http://localhost:3000
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=Lax
DEFAULT_PROFILE_IMAGE_BASE_URL=http://localhost:8080/api/public/profile-images/
